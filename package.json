{
  "name": "agent-switchboard",
  "version": "1.3.4",
  "private": true,
  "workspaces": [
    "com.local.rexagents.sdPlugin",
    "tools"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:golden": "node --test tests/integration/golden.test.js",
    "test:distribution": "python3 -m unittest discover -s tests -v",
    "test:coverage": "node tools/node_modules/c8/bin/c8.js node --test",
    "lint": "node tools/node_modules/eslint/bin/eslint.js .",
    "format": "node tools/node_modules/prettier/bin/prettier.cjs --write \"**/*.{js,cjs,mjs,ts,html,json,yml,yaml}\"",
    "format:check": "node tools/node_modules/prettier/bin/prettier.cjs --check \"**/*.{js,cjs,mjs,ts,html,json,yml,yaml}\"",
    "build": "python3 build.py",
    "clean": "node scripts/clean.mjs",
    "knip": "node tools/node_modules/knip/bin/knip.js --include files,dependencies,unlisted,binaries --no-config-hints",
    "typecheck": "node tools/node_modules/typescript/bin/tsc --pretty false"
  }
}
