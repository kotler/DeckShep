{
  "name": "agent-switchboard",
  "version": "1.3.4",
  "private": true,
  "workspaces": [
    "com.local.rexagents.sdPlugin",
    "tools"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --require tsx/cjs --test",
    "test:golden": "node --require tsx/cjs --test tests/integration/golden.test.js",
    "test:distribution": "node --require tsx/cjs --test tests/integration/distribution.test.js",
    "test:coverage": "node scripts/tool.mjs c8 node --require tsx/cjs --test",
    "lint": "node scripts/tool.mjs eslint .",
    "format": "node scripts/tool.mjs prettier --write \"**/*.{js,cjs,mjs,ts,html,json,yml,yaml}\"",
    "format:check": "node scripts/tool.mjs prettier --check \"**/*.{js,cjs,mjs,ts,html,json,yml,yaml}\"",
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "knip": "node scripts/tool.mjs knip --include files,dependencies,unlisted,binaries --no-config-hints",
    "typecheck": "node scripts/tool.mjs typescript --pretty false",
    "deps": "node scripts/tool.mjs dependency-cruiser src --config .dependency-cruiser.cjs",
    "package": "node scripts/package.mjs",
    "doctor": "node --require tsx/cjs src/plugin/doctor-entry.ts",
    "dev": "node scripts/dev.mjs",
    "test:bundled": "node scripts/test-bundled.mjs",
    "test:live": "node --require tsx/cjs --test tests/live/*.test.js",
    "version:check": "node scripts/version.mjs --check",
    "version:sync": "node scripts/version.mjs",
    "compatibility": "node --import tsx scripts/compatibility.mjs",
    "compatibility:check": "node --import tsx scripts/compatibility.mjs --check",
    "commitlint": "node scripts/tool.mjs @commitlint/cli"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@elgato/streamdeck": "2.1.2",
    "@iarna/toml": "2.2.5",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@types/node": "20.19.43",
    "@types/ws": "8.18.2",
    "dependency-cruiser": "18.7.2",
    "rollup": "4.68.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "ws": "8.22.1",
    "zod": "4.6.7"
  }
}
