{
  "workspaces": {
    ".": {
      "entry": [
        "src/plugin/entry.mts",
        "src/plugin/*entry.ts",
        "src/inspector/index.ts",
        "src/app/preferences.ts",
        "tests/**/*.test.js",
        "tests/fixtures/**/*.{js,cjs,ts}",
        "scripts/*.{mjs,cjs}",
        "eslint.config.mjs",
        "commitlint.config.cjs",
        ".dependency-cruiser.cjs",
        "src/agents/claude/hook.ts",
        "src/plugin/private-logger.ts",
        "tests/integration/host/dependencies.ts",
        "tests/e2e/virtual-host/scenario-dependencies.ts",
        "tests/e2e/virtual-deck/app.js",
        "tests/e2e/*.spec.ts",
        "playwright.config.ts",
        "src/plugin/host-socket.mts"
      ],
      "project": [
        "src/**/*.{ts,mts}",
        "tests/**/*.{js,cjs,ts}",
        "scripts/*.{mjs,cjs}"
      ]
    },
    "com.kotl3r.deckshep.sdPlugin": {
      "entry": [],
      "project": []
    },
    "tools": {
      "entry": ["e2e.ts"],
      "project": ["*.ts"]
    }
  },
  "ignore": ["src/terminals/herdr-app/**", "src/terminals/contract/fixture.ts"],
  "ignoreDependencies": [
    "@elgato/cli",
    "@eslint/js",
    "@commitlint/cli",
    "@commitlint/config-conventional",
    "c8",
    "eslint",
    "globals",
    "prettier",
    "dependency-cruiser",
    "knip",
    "typescript",
    "tsx",
    "@typescript/native"
  ]
}
