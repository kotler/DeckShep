{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": ["./tools/node_modules/@types"],
    "types": ["node", "ws"],
    "lib": ["ES2023", "DOM", "ES2022.Intl"],
    "paths": {
      "ws": ["./tools/node_modules/@types/ws/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "com.local.rexagents.sdPlugin/*.js"]
}
