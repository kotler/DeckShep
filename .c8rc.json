{
  "all": true,
  "include": [
    "src/**/*.ts",
    "src/**/*.mts"
  ],
  "exclude": [
    "**/node_modules/**",
    "tests/**",
    "dist/**",
    "src/**/*.d.ts",
    "src/domain/types.ts",
    "src/domain/backend.ts",
    "src/plugin/**"
  ],
  "reporter": [
    "text",
    "json-summary",
    "lcov"
  ],
  "reports-dir": "coverage"
}
